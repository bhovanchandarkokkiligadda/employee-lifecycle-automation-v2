    <sys_module action="INSERT_OR_UPDATE">
        <content><![CDATA[import { gs } from '@servicenow/glide';
export function preventModificationCompleted(current, previous) {
    var previousStatus = previous.getValue('status');
    if (previousStatus === 'completed' || previousStatus === 'cancelled') {
        gs.addErrorMessage('Cannot modify completed or cancelled records');
        current.setAbortAction(true);
    }
}
]]></content>
